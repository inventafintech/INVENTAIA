# .env.example — INVENTA.AI
# Cópialo como `.env.local` y rellena tus valores. NUNCA commitees el `.env.local`.
# En Vercel: Project → Settings → Environment Variables (mismos nombres).

# --- Google OAuth 2.0 (login con Google) ---
# Consola: https://console.cloud.google.com/apis/credentials → crear Client ID web.
# Añade como redirect autorizado: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=tu_client_id_de_google
GOOGLE_CLIENT_SECRET=tu_client_secret_de_google

# --- NextAuth (sesiones) ---
# URL base de tu entorno local.
NEXTAUTH_URL=http://localhost:3000
# Secreto largo aleatorio. Genera uno con: openssl rand -hex 32
NEXTAUTH_SECRET=tu_secreto_nextauth_aqui
# Secreto para firmar los JWT internos (distinto del anterior).
JWT_SECRET=tu_secreto_jwt_aqui
# Entorno: development en local, production en Vercel.
NODE_ENV=development

# --- Supabase (base de datos y auth) ---
# Dashboard de tu proyecto: Settings → API → Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://tu_proyecto.supabase.co
# Clave pública (anon/publishable): Settings → API → Publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu_clave_publica_aqui

# --- Google Gemini (IA Nexo) ---
# Consola: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=tu_api_key_de_gemini
# Modelo por defecto para Nexo.
GEMINI_MODEL=gemini-3.8-flash
# --- Groq (IA Nexo, alternativo) ---
# Consola: https://console.groq.com/keys
GROQ_API_KEY=tu_api_key_de_groq

# --- NOTA: VERCEL_OIDC_TOKEN lo genera solo la CLI de Vercel. No lo pongas a mano. ---

# ==================== OPCIONALES (solo si usas esas integraciones) ====================

# --- Base de datos directa (Prisma) ---
# DATABASE_URL=postgresql://usuario:password@host:5432/inventa

# --- Supabase service role (solo backend, NUNCA con prefijo NEXT_PUBLIC) ---
# SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# --- Webhook interno de memoria Nexo ---
# NEXO_WEBHOOK_SECRET=tu_secreto_webhook_aqui
# --- Sesiones (alternativo a JWT_SECRET) ---
# SESSION_SECRET=tu_session_secret_aqui

# --- Stripe (facturación) ---
# STRIPE_SECRET_KEY=sk_test_tu_clave_aqui

# --- WhatsApp Cloud API ---
# WHATSAPP_CLOUD_API_TOKEN=tu_token_aqui
# WHATSAPP_API_TOKEN=tu_token_aqui
# WHATSAPP_ACCESS_TOKEN=tu_token_aqui
# WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id_aqui

# --- SAP ---
# SAP_HOST=tu_host_sap
# SAP_USERNAME=tu_usuario
# SAP_PASSWORD=tu_password
# SAP_API_KEY=tu_api_key
# SAP_CLIENT=100

# --- Mercado Libre ---
# MELI_APP_ID=tu_app_id
# MELI_CLIENT_SECRET=tu_client_secret

# --- Shopify ---
# SHOPIFY_API_KEY=tu_api_key
# SHOPIFY_API_SECRET=tu_api_secret

# --- Amazon SP-API ---
# AMAZON_CLIENT_ID=tu_client_id
# AMAZON_CLIENT_SECRET=tu_client_secret
# AMAZON_REFRESH_TOKEN=tu_refresh_token

# --- SUNAT ---
# SUNAT_RUC=tu_ruc
# SUNAT_USUARIO_SOL=tu_usuario_sol
# SUNAT_CLAVE_SOL=tu_clave_sol

# --- Banco Pichincha (financiamiento) ---
# PICHINCHA_CLIENT_ID=tu_client_id
# PICHINCHA_CLIENT_SECRET=tu_client_secret
# PICHINCHA_API_URL=https://api.pichincha.com
