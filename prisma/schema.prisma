datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum IntegrationType {
  corporate
  traditional
}

enum POStatus {
  draft
  approved
  transit
  received
}

enum CreditLineStatus {
  active
  suspended
  pending_configuration
}

enum DisbursementStatus {
  pending
  approved
  disbursed
  rejected
  failed
}

enum ProductStatus {
  active
  inactive
  archived
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  created_at  DateTime  @default(now())

  products    Product[]

  @@map("categories")
}

model Product {
  id          String        @id @default(uuid())
  sku_code    String        @unique
  name        String
  category_id String
  category    Category      @relation(fields: [category_id], references: [id])
  unit_cost   Decimal       @db.Decimal(12, 2)
  unit_price  Decimal       @db.Decimal(12, 2)
  status      ProductStatus @default(active)
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt

  inventory           InventoryLevel?
  forecast_logs       ForecastAccuracyLog[]
  prevented_stockouts PreventedStockout[]

  @@index([sku_code])
  @@index([category_id])
  @@map("products")
}

model InventoryLevel {
  id             String   @id @default(uuid())
  product_id     String   @unique
  product        Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  physical_stock Int      @default(0)
  safety_stock   Int      @default(0)
  last_synced_at DateTime @default(now())

  @@index([product_id])
  @@index([physical_stock])
  @@map("inventory_levels")
}

model Supplier {
  id               String          @id @default(uuid())
  name             String
  contact_info     Json            @default("{}")
  integration_type IntegrationType @default(traditional)
  lead_time_days   Int             @default(5)
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt

  purchase_orders  PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseOrder {
  id                String              @id @default(uuid())
  order_number      String              @unique
  supplier_id       String
  supplier          Supplier            @relation(fields: [supplier_id], references: [id])
  condition         String
  total_amount      Decimal             @db.Decimal(14, 2)
  estimated_arrival DateTime
  status            POStatus            @default(draft)
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt

  lines             PurchaseOrderLine[]

  @@index([status])
  @@index([supplier_id])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id         String        @id @default(uuid())
  po_id      String
  po         PurchaseOrder @relation(fields: [po_id], references: [id], onDelete: Cascade)
  sku        String
  quantity   Int
  unit_price Decimal       @db.Decimal(12, 2)
  created_at DateTime      @default(now())

  @@index([po_id])
  @@index([sku])
  @@map("purchase_order_lines")
}

model CreditLine {
  id                    String                @id @default(uuid())
  partner_bank_id       String
  total_amount          Decimal               @db.Decimal(14, 2)
  available_amount      Decimal               @db.Decimal(14, 2)
  monthly_interest_rate Decimal               @db.Decimal(6, 4) @default(0.0145)
  status                CreditLineStatus      @default(active)
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt

  disbursements         DisbursementRequest[]

  @@index([partner_bank_id])
  @@map("credit_lines")
}

model DisbursementRequest {
  id               String             @id @default(uuid())
  credit_line_id   String
  credit_line      CreditLine         @relation(fields: [credit_line_id], references: [id])
  requested_amount Decimal            @db.Decimal(14, 2)
  term_days        Int
  financial_cost   Decimal            @db.Decimal(12, 2)
  status           DisbursementStatus @default(pending)
  created_at       DateTime           @default(now())

  @@index([credit_line_id])
  @@map("disbursement_requests")
}

model IntegrationLog {
  id          String   @id @default(uuid())
  fecha       DateTime @default(now())
  usuario     String
  integracion String
  resultado   String
  errores     String?

  @@index([integracion])
  @@index([fecha])
  @@index([resultado])
  @@index([fecha, resultado])
  @@map("integration_logs")
}

model ForecastAccuracyLog {
  id               String   @id @default(uuid())
  product_id       String
  product          Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  forecasted_demand Decimal  @db.Decimal(12, 2)
  actual_demand    Decimal  @db.Decimal(12, 2)
  mape_score       Decimal  @db.Decimal(6, 4)
  calculated_at    DateTime @default(now())

  @@index([product_id])
  @@index([calculated_at])
  @@map("forecast_accuracy_logs")
}

model InventorySavingsLog {
  id           String   @id @default(uuid())
  saved_amount Decimal  @db.Decimal(14, 2)
  action_type  String
  created_at   DateTime @default(now())

  @@index([created_at])
  @@map("inventory_savings_logs")
}

model PreventedStockout {
  id              String   @id @default(uuid())
  product_id      String
  product         Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  days_prevented  Int
  created_at      DateTime @default(now())

  @@index([product_id])
  @@index([created_at])
  @@map("prevented_stockouts")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  avatar_url String?
  google_id  String?  @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  workspaces WorkspaceUser[]

  @@index([email])
  @@index([google_id])
  @@map("users")
}

model Workspace {
  id         String   @id @default(uuid())
  name       String
  slug_url   String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  users WorkspaceUser[]

  @@index([slug_url])
  @@map("workspaces")
}

model WorkspaceUser {
  id           String        @id @default(uuid())
  user_id      String
  workspace_id String
  role         WorkspaceRole @default(OWNER)
  created_at   DateTime      @default(now())

  user      User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@unique([user_id, workspace_id])
  @@index([user_id])
  @@index([workspace_id])
  @@index([role])
  @@map("workspace_users")
}

