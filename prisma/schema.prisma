datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum IntegrationType {
  corporate
  traditional
}

enum POStatus {
  draft
  approved
  transit
  received
}

enum CreditLineStatus {
  active
  suspended
  pending_configuration
}

enum DisbursementStatus {
  pending
  approved
  disbursed
  rejected
  failed
}

enum ProductStatus {
  active
  inactive
  archived
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  created_at  DateTime  @default(now())

  products    Product[]

  @@map("categories")
}

model Product {
  id          String        @id @default(uuid())
  sku_code    String        @unique
  name        String
  category_id String
  category    Category      @relation(fields: [category_id], references: [id])
  unit_cost   Decimal       @db.Decimal(12, 2)
  unit_price  Decimal       @db.Decimal(12, 2)
  status      ProductStatus @default(active)
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt

  inventory   InventoryLevel?

  @@index([sku_code])
  @@index([category_id])
  @@map("products")
}

model InventoryLevel {
  id             String   @id @default(uuid())
  product_id     String   @unique
  product        Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  physical_stock Int      @default(0)
  safety_stock   Int      @default(0)
  last_synced_at DateTime @default(now())

  @@index([product_id])
  @@map("inventory_levels")
}

model Supplier {
  id               String          @id @default(uuid())
  name             String
  contact_info     Json            @default("{}")
  integration_type IntegrationType @default(traditional)
  lead_time_days   Int             @default(5)
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt

  purchase_orders  PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseOrder {
  id                String              @id @default(uuid())
  order_number      String              @unique
  supplier_id       String
  supplier          Supplier            @relation(fields: [supplier_id], references: [id])
  condition         String
  total_amount      Decimal             @db.Decimal(14, 2)
  estimated_arrival DateTime
  status            POStatus            @default(draft)
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt

  lines             PurchaseOrderLine[]

  @@index([status])
  @@index([supplier_id])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id         String        @id @default(uuid())
  po_id      String
  po         PurchaseOrder @relation(fields: [po_id], references: [id], onDelete: Cascade)
  sku        String
  quantity   Int
  unit_price Decimal       @db.Decimal(12, 2)
  created_at DateTime      @default(now())

  @@index([po_id])
  @@index([sku])
  @@map("purchase_order_lines")
}

model CreditLine {
  id                    String                @id @default(uuid())
  partner_bank_id       String
  total_amount          Decimal               @db.Decimal(14, 2)
  available_amount      Decimal               @db.Decimal(14, 2)
  monthly_interest_rate Decimal               @db.Decimal(6, 4) @default(0.0145)
  status                CreditLineStatus      @default(active)
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt

  disbursements         DisbursementRequest[]

  @@index([partner_bank_id])
  @@map("credit_lines")
}

model DisbursementRequest {
  id               String             @id @default(uuid())
  credit_line_id   String
  credit_line      CreditLine         @relation(fields: [credit_line_id], references: [id])
  requested_amount Decimal            @db.Decimal(14, 2)
  term_days        Int
  financial_cost   Decimal            @db.Decimal(12, 2)
  status           DisbursementStatus @default(pending)
  created_at       DateTime           @default(now())

  @@index([credit_line_id])
  @@map("disbursement_requests")
}

model IntegrationLog {
  id          String   @id @default(uuid())
  fecha       DateTime @default(now())
  usuario     String
  integracion String
  resultado   String
  errores     String?

  @@index([integracion])
  @@index([fecha])
  @@map("integration_logs")
}
